{
  "scope": "community",
  "name": "google-drive",
  "version": "1.1.0",
  "description": "Commands to interact with Google Drive using the Drive v3 REST API",
  "license": "MIT",
  "tags": [
    "google",
    "drive",
    "google-workspace",
    "rest",
    "cli",
    "files"
  ],
  "dependencies": [
    "community/google-auth",
    "aux4/curl"
  ],
  "system": [
    [
      "test:jq --version",
      "brew:jq",
      "linux:jq"
    ],
    [
      "test:file --version",
      "brew:file-formula",
      "linux:file"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "google",
          "execute": [
            "profile:google"
          ],
          "help": {
            "text": "Google commands"
          }
        }
      ]
    },
    {
      "name": "google",
      "commands": [
        {
          "name": "drive",
          "execute": [
            "profile:google:drive"
          ],
          "help": {
            "text": "Google Drive commands"
          }
        }
      ]
    },
    {
      "name": "google:drive",
      "commands": [
        {
          "name": "services",
          "private": true,
          "execute": [
            "echo '{\"name\":\"drive\",\"scope\":\"https://www.googleapis.com/auth/drive\",\"readonlyScope\":\"https://www.googleapis.com/auth/drive.readonly\",\"description\":\"Manage files, folders, and shared drives\"}'"
          ],
          "help": {
            "text": "Output service metadata for auth resolution"
          }
        },
        {
          "name": "list",
          "execute": [
            "json:DRIVE_QUERY=value(query) DRIVE_ORDER_BY=value(orderBy) jq -nc '{query: (env.DRIVE_QUERY | @uri), orderBy: (env.DRIVE_ORDER_BY | @uri)}'",
            "set:encoded=$response",
            "set:requestUrl=${apiUrl}/files?q=${encoded.query}&fields=files(id,name,mimeType,modifiedTime,size,webViewLink),nextPageToken&pageSize=${pageSize}&orderBy=${encoded.orderBy}",
            "aux4 curl auth-request --provider google param(tokenFile) --url value(requestUrl)"
          ],
          "help": {
            "text": "List files in Google Drive",
            "variables": [
              {
                "name": "query",
                "text": "Search query (e.g. name contains 'report')",
                "default": "trashed = false"
              },
              {
                "name": "pageSize",
                "text": "Number of files to return",
                "default": "20"
              },
              {
                "name": "orderBy",
                "text": "Sort order (e.g. modifiedTime desc, name)",
                "default": "modifiedTime desc"
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "search",
          "execute": [
            "nout:DRIVE_NAME=value(name) DRIVE_QUOTE=\"'\" jq -rn '(\"name contains \" + env.DRIVE_QUOTE + (env.DRIVE_NAME | gsub(env.DRIVE_QUOTE; \"\\\\\" + env.DRIVE_QUOTE)) + env.DRIVE_QUOTE + \" and trashed = false\") | @uri'",
            "set:encodedQuery=$response",
            "set:requestUrl=${apiUrl}/files?q=${encodedQuery}&fields=files(id,name,mimeType,modifiedTime,webViewLink)&pageSize=${pageSize}",
            "aux4 curl auth-request --provider google param(tokenFile) --url value(requestUrl)"
          ],
          "help": {
            "text": "Search files by name",
            "variables": [
              {
                "name": "name",
                "text": "File name to search for",
                "arg": true
              },
              {
                "name": "pageSize",
                "text": "Number of results to return",
                "default": "10"
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "id",
          "execute": [
            "json:DRIVE_PATH=value(name) jq -nc 'env.DRIVE_PATH | split(\"/\") | map(select(. != \"\")) | {head: .[0], tail: (.[1:] | join(\"/\"))}'",
            "set:segment=$response",
            "when:${segment.head}==:exit:1:A file name or path is required.",
            "when:${segment.tail}==:aux4 google drive resolve value(name) param(tokenFile) --apiUrl value(apiUrl)",
            "when:${segment.tail}!=:aux4 google drive resolve value(name) --parent root param(tokenFile) --apiUrl value(apiUrl)"
          ],
          "help": {
            "text": "Get the file ID by name or path",
            "variables": [
              {
                "name": "name",
                "text": "File name or path (e.g. report or folder/subfolder/report)",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "resolve",
          "private": true,
          "execute": [
            "json:DRIVE_PATH=value(path) jq -nc 'env.DRIVE_PATH | split(\"/\") | map(select(. != \"\")) | {head: .[0], tail: (.[1:] | join(\"/\"))}'",
            "set:segment=$response",
            "when:${segment.head}==:exit:1:A file name or path is required.",
            "set:parentClause=",
            "when:${parent}!=:set:parentClause='${parent}' in parents",
            "set:typeClause=",
            "when:${segment.tail}!=:set:typeClause=mimeType = 'application/vnd.google-apps.folder'",
            "nout:DRIVE_NAME=value(segment.head) DRIVE_PARENT_CLAUSE=value(parentClause) DRIVE_TYPE_CLAUSE=value(typeClause) DRIVE_QUOTE=\"'\" jq -rn '[(\"name = \" + env.DRIVE_QUOTE + (env.DRIVE_NAME | gsub(env.DRIVE_QUOTE; \"\\\\\" + env.DRIVE_QUOTE)) + env.DRIVE_QUOTE), env.DRIVE_PARENT_CLAUSE, env.DRIVE_TYPE_CLAUSE, \"trashed = false\"] | map(select(. != \"\")) | join(\" and \") | @uri'",
            "set:encodedQuery=$response",
            "set:requestUrl=${apiUrl}/files?q=${encodedQuery}&fields=files(id)&pageSize=1",
            "nout:aux4 curl auth-request --provider google param(tokenFile) --url value(requestUrl)",
            "set:matches=$response",
            "set:foundId=!DRIVE_MATCHES=value(matches) jq -rn 'env.DRIVE_MATCHES | fromjson | .files[0].id // empty'",
            "when:${foundId}==:exit:1:not found: ${segment.head}",
            "when:${segment.tail}==:log:${foundId}",
            "when:${segment.tail}!=:aux4 google drive resolve value(segment.tail) --parent value(foundId) param(tokenFile) --apiUrl value(apiUrl)"
          ],
          "help": {
            "text": "Resolve one path segment at a time to a file ID",
            "variables": [
              {
                "name": "path",
                "text": "Remaining path to resolve",
                "arg": true
              },
              {
                "name": "parent",
                "text": "Folder ID the next segment must live in (empty searches the whole Drive)",
                "default": ""
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "get",
          "execute": [
            "set:requestUrl=${apiUrl}/files/${fileId}?fields=id,name,mimeType,modifiedTime,size,webViewLink,parents,shared,owners",
            "aux4 curl auth-request --provider google param(tokenFile) --url value(requestUrl)"
          ],
          "help": {
            "text": "Get file metadata by ID",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "copy",
          "execute": [
            "set:requestUrl=${apiUrl}/files/${fileId}/copy",
            "set:requestBody=object(name)",
            "aux4 curl auth-request --provider google param(tokenFile) --method POST --url value(requestUrl) --header 'Content-Type: application/json' --body value(requestBody)"
          ],
          "help": {
            "text": "Create a copy of a file",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID to copy",
                "arg": true
              },
              {
                "name": "name",
                "text": "Name for the copy"
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "rename",
          "execute": [
            "set:requestUrl=${apiUrl}/files/${fileId}",
            "set:requestBody=object(name)",
            "aux4 curl auth-request --provider google param(tokenFile) --method PATCH --url value(requestUrl) --header 'Content-Type: application/json' --body value(requestBody)"
          ],
          "help": {
            "text": "Rename a file",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID to rename",
                "arg": true
              },
              {
                "name": "name",
                "text": "New name for the file"
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "move",
          "execute": [
            "set:requestUrl=${apiUrl}/files/${fileId}?addParents=${folderId}",
            "when:${fromFolderId}!=:set:requestUrl=${apiUrl}/files/${fileId}?addParents=${folderId}&removeParents=${fromFolderId}",
            "aux4 curl auth-request --provider google param(tokenFile) --method PATCH --url value(requestUrl)"
          ],
          "help": {
            "text": "Move a file to a different folder",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID to move",
                "arg": true
              },
              {
                "name": "folderId",
                "text": "Destination folder ID"
              },
              {
                "name": "fromFolderId",
                "text": "Folder ID to remove the file from (optional, Drive replaces the single existing parent anyway)",
                "default": ""
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "confirm:Are you sure you want to permanently delete this file?",
            "set:requestUrl=${apiUrl}/files/${fileId}",
            "aux4 curl auth-request --provider google param(tokenFile) --method DELETE --url value(requestUrl)",
            "log:Permanently deleted ${fileId}"
          ],
          "help": {
            "text": "Permanently delete a file",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID to delete",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "trash",
          "execute": [
            "set:requestUrl=${apiUrl}/files/${fileId}?fields=id,name,mimeType,trashed",
            "aux4 curl auth-request --provider google param(tokenFile) --method PATCH --url value(requestUrl) --header 'Content-Type: application/json' --body '{\"trashed\": true}'"
          ],
          "help": {
            "text": "Move a file to trash",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID to trash",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "restore",
          "execute": [
            "set:requestUrl=${apiUrl}/files/${fileId}?fields=id,name,mimeType,trashed",
            "aux4 curl auth-request --provider google param(tokenFile) --method PATCH --url value(requestUrl) --header 'Content-Type: application/json' --body '{\"trashed\": false}'"
          ],
          "help": {
            "text": "Restore a file from trash",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID to restore",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "upload",
          "execute": [
            "# The existence check comes first because `file` reports a missing path on stdout, which would end up in the Content-Type header.",
            "nout:ls value(file)",
            "set:sourceName=!basename value(file)",
            "set:targetName=nvl(name, sourceName)",
            "when:${mimeType}==:set:mimeType=!file --mime-type -b value(file)",
            "set:contentTypeHeader=Content-Type: ${mimeType}",
            "set:uploadRequestPath=/files?uploadType=media&fields=id,name",
            "set:uploadRequestUrl=${uploadApiUrl}${uploadRequestPath}",
            "json:aux4 curl auth-request --provider google param(tokenFile) --method POST --url value(uploadRequestUrl) --header value(contentTypeHeader) --bodyFile value(file)",
            "set:uploaded=$response",
            "when:${uploaded.id}==:exit:1:The upload did not return a file id.",
            "set:metadataRequestUrl=${apiUrl}/files/${uploaded.id}?fields=id,name,mimeType,parents,webViewLink",
            "when:${parent}!=:set:metadataRequestUrl=${apiUrl}/files/${uploaded.id}?addParents=${parent}&fields=id,name,mimeType,parents,webViewLink",
            "set:requestBody=object(targetName:name)",
            "aux4 curl auth-request --provider google param(tokenFile) --method PATCH --url value(metadataRequestUrl) --header 'Content-Type: application/json' --body value(requestBody)"
          ],
          "help": {
            "text": "Upload a file to Google Drive",
            "variables": [
              {
                "name": "file",
                "text": "Path to the local file to upload",
                "arg": true
              },
              {
                "name": "parent",
                "text": "Parent folder ID",
                "default": ""
              },
              {
                "name": "name",
                "text": "Target filename (defaults to source filename)",
                "default": ""
              },
              {
                "name": "mimeType",
                "text": "Content type of the upload (detected from the file when empty)",
                "default": ""
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              },
              {
                "name": "uploadApiUrl",
                "text": "Drive upload API base URL",
                "default": "https://www.googleapis.com/upload/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "download",
          "execute": [
            "set:requestUrl=${apiUrl}/files/${fileId}?alt=media",
            "aux4 curl auth-request --provider google param(tokenFile) --url value(requestUrl) --output value(output)",
            "log:Saved ${output}"
          ],
          "help": {
            "text": "Download a file from Google Drive",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID to download",
                "arg": true
              },
              {
                "name": "output",
                "text": "Output file path"
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "export",
          "execute": [
            "nout:DRIVE_MIME_TYPE=value(mimeType) jq -rn 'env.DRIVE_MIME_TYPE | @uri'",
            "set:encodedMimeType=$response",
            "set:requestUrl=${apiUrl}/files/${fileId}/export?mimeType=${encodedMimeType}",
            "aux4 curl auth-request --provider google param(tokenFile) --url value(requestUrl) --output value(output)",
            "log:Saved ${output}"
          ],
          "help": {
            "text": "Export a Google Workspace document to a file",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID to export",
                "arg": true
              },
              {
                "name": "output",
                "text": "Output file path"
              },
              {
                "name": "mimeType",
                "text": "Export MIME type (e.g. application/pdf, text/csv)",
                "default": "application/pdf",
                "options": [
                  "application/pdf",
                  "text/csv",
                  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                  "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                  "text/plain",
                  "text/html"
                ]
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "mkdir",
          "execute": [
            "nout:DRIVE_NAME=value(name) DRIVE_PARENT=value(parent) jq -nc '{name: env.DRIVE_NAME, mimeType: \"application/vnd.google-apps.folder\", parents: [env.DRIVE_PARENT]}'",
            "set:requestBody=$response",
            "set:requestPath=/files",
            "set:requestUrl=${apiUrl}${requestPath}",
            "aux4 curl auth-request --provider google param(tokenFile) --method POST --url value(requestUrl) --header 'Content-Type: application/json' --body value(requestBody)"
          ],
          "help": {
            "text": "Create a folder in Google Drive",
            "variables": [
              {
                "name": "name",
                "text": "Folder name",
                "arg": true
              },
              {
                "name": "parent",
                "text": "Parent folder ID (defaults to root)",
                "default": "root"
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "share",
          "execute": [
            "profile:google:drive:share"
          ],
          "help": {
            "text": "Manage file sharing permissions"
          }
        }
      ]
    },
    {
      "name": "google:drive:share",
      "commands": [
        {
          "name": "add",
          "execute": [
            "set:requestUrl=${apiUrl}/files/${fileId}/permissions",
            "set:requestBody=object(role, type, email:emailAddress)",
            "aux4 curl auth-request --provider google param(tokenFile) --method POST --url value(requestUrl) --header 'Content-Type: application/json' --body value(requestBody)"
          ],
          "help": {
            "text": "Share a file with a user or group",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID to share",
                "arg": true
              },
              {
                "name": "email",
                "text": "Email address to share with"
              },
              {
                "name": "role",
                "text": "Permission role",
                "default": "reader",
                "options": [
                  "reader",
                  "commenter",
                  "writer",
                  "organizer"
                ]
              },
              {
                "name": "type",
                "text": "Permission type",
                "default": "user",
                "options": [
                  "user",
                  "group",
                  "domain",
                  "anyone"
                ]
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "set:requestUrl=${apiUrl}/files/${fileId}/permissions?fields=permissions(id,role,type,emailAddress,displayName)",
            "aux4 curl auth-request --provider google param(tokenFile) --url value(requestUrl)"
          ],
          "help": {
            "text": "List sharing permissions for a file",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        },
        {
          "name": "remove",
          "execute": [
            "set:requestUrl=${apiUrl}/files/${fileId}/permissions/${permissionId}",
            "aux4 curl auth-request --provider google param(tokenFile) --method DELETE --url value(requestUrl)",
            "log:Removed permission ${permissionId} from ${fileId}"
          ],
          "help": {
            "text": "Remove a sharing permission from a file",
            "variables": [
              {
                "name": "fileId",
                "text": "File ID",
                "arg": true
              },
              {
                "name": "permissionId",
                "text": "Permission ID to remove"
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Drive API base URL",
                "default": "https://www.googleapis.com/drive/v3",
                "private": true
              }
            ]
          }
        }
      ]
    }
  ]
}
